{
  "name": "@agent-graph/tui",
  "version": "0.1.0",
  "description": "Terminal user interface for agent platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "agent-graph-tui": "./dist/tui.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agent-graph/core": "file:../core",
    "@agent-graph/agents": "file:../agents",
    "@agent-graph/cli": "file:../cli",
    "ink": "^4.4.1",
    "react": "^18.3.1",
    "ink-spinner": "^5.0.0",
    "ink-select-input": "^5.0.0",
    "ink-text-input": "^5.0.0",
    "chalk": "^4.1.2",
    "figlet": "^1.7.0",
    "boxen": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.3",
    "@types/figlet": "^1.5.8",
    "typescript": "^5.5.4"
  }
}